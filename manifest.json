{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "MBLX-Hitbox-color-changer",
  "version": "1.10.0",
  "description": "A browser extension to mod an online game. This program was created by combining footage from SmoothDude's videos.",
  "author": "ZataLove_JP_Kohaku",
  "icons": {
    "128": "MBLX_TP_icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MBLX Hitbox Color Changer"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://miniblox.io/*",
    "https://miniblox.online/*",
    "https://www.xbitlabs.com/ja/*", 
    "https://miniblox.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*",
        "https://www.xbitlabs.com/ja/*", 
        "https://miniblox.org/*"
      ],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*",
        "https://www.xbitlabs.com/ja/*", 
        "https://miniblox.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
